# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Free cluster: https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/krishiseva?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=krishiseva_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── OTP: SMS Gateways (uncomment the one you use) ─────────────────────────────
Option A — Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1415xxxxxxx

# Option B — MSG91
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_otp_template_id

# Option C — Standard NodeMailer SMTP (Gmail, Brevo, AWS SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="KrishiSeva" <zsawji06@gmail.com>

# ── Razorpay (legacy — kept for existing orders) ──────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
# Test keys (sk_test_xxx / pk_test_xxx) — no real money charged
# Leave as REPLACE_ME to use the built-in sandbox mock (no Stripe account needed)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── AI Chatbot ────────────────────────────────────────────────────────────────
# Option A: Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-xxxx

# Option B: OpenAI (https://platform.openai.com)
# OPENAI_API_KEY=sk-xxxxxx
